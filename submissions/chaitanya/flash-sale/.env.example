# =============================================================================
# Flash Sale Inventory Reservation System — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# The .env file is NOT automatically loaded by Spring Boot. You must either:
#   1. Set these as real environment variables, or
#   2. Use an IDE/launcher that reads .env (IntelliJ EnvFile plugin), or
#   3. Export them manually before starting: export $(cat .env | xargs)
# =============================================================================

# Active Spring profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# Server port
SERVER_PORT=8080

# H2 Database Configuration
# For dev (file-based persistence): jdbc:h2:file:./data/flashsale;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# For test (in-memory): jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
FLASH_SALE_DB_URL=jdbc:h2:file:./data/flashsale;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
FLASH_SALE_DB_USERNAME=sa
FLASH_SALE_DB_PASSWORD=

# H2 Console (only enable in dev; disabled in prod profile)
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console

# Reservation TTL in seconds (default: 120)
RESERVATION_TTL_SECONDS=120

# Expiration scheduler interval in milliseconds (default: 5000)
EXPIRATION_INTERVAL_MS=5000

# Logging level (TRACE, DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL=INFO

# Show SQL statements (true/false)
JPA_SHOW_SQL=false